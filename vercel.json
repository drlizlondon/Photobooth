    { "source": "/", "destination": "/index.html" },
    { "source": "/business", "destination": "/index.html" },
    { "source": "/business/", "destination": "/index.html" },
    { "source": "/david-lloyd", "destination": "/index.html" },
    { "source": "/david-lloyd/", "destination": "/index.html" }
